local function GetRefScreenPos(cam)
    if Config.DeviceMode == "PC" and Mouse then
        return Vector2.new(Mouse.X, Mouse.Y + 36)
    end
    return Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
end

local function IsPlayerAliveWithHead(plr)
    if not plr or plr == LocalPlayer then return false, nil, nil end
    local char = plr.Character
    if not char then return false, nil, nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if hum and hum.Health > 0 and head then
        return true, head, hum
    end
    return false, nil, nil
end

local function IsPartInsideFOV(cam, part, refPos, radius)
    if not cam or not part or not part.Parent then return false, nil, math.huge end
    local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
    if not onScreen or screenPos.Z <= 0 then
        return false, screenPos, math.huge
    end
    local dist = (Vector2.new(screenPos.X, screenPos.Y) - refPos).Magnitude
    return dist <= radius, screenPos, dist
end

local function HasAnyAimFeatureActive()
    return Config.FOVVisible
        or Config.AimAssistEnabled
        or Config.SilentAimEnabled
        or Config.TracerEnabled
end

local function UpdateSingleFOVLock(cam, refPos)
    if not HasAnyAimFeatureActive() then
        State.LockedTarget = nil
        State.LockedPart = nil
        return nil
    end

    if State.LockedTarget then
        local alive, head = IsPlayerAliveWithHead(State.LockedTarget)
        if alive and head then
            local inside = IsPartInsideFOV(cam, head, refPos, Config.FOVRadius)
            if inside then
                State.LockedPart = head
                return head
            end
        end
        State.LockedTarget = nil
        State.LockedPart = nil
    end

    local closestDist = Config.FOVRadius
    local chosenPlr = nil
    local chosenHead = nil

    for _, plr in ipairs(Players:GetPlayers()) do
        local alive, head = IsPlayerAliveWithHead(plr)
        if alive and head then
            local inside, _, dist = IsPartInsideFOV(cam, head, refPos, Config.FOVRadius)
            if inside and dist < closestDist then
                closestDist = dist
                chosenPlr = plr
                chosenHead = head
            end
        end
    end

    State.LockedTarget = chosenPlr
    State.LockedPart = chosenHead
    return chosenHead
end

-- Independent Tracer updater: only draws when TracerEnabled is true AND there is a locked target
local function UpdateLockedTracer(cam, refPos, lockedHead)
    if not Config.TracerEnabled or not State.LockedTarget or not lockedHead or not lockedHead.Parent then
        TracerLine.Visible = false
        return
    end

    local targetPos, onScreen = cam:WorldToViewportPoint(lockedHead.Position)
    if onScreen and targetPos.Z > 0 then
        TracerLine.From = refPos
        TracerLine.To = Vector2.new(targetPos.X, targetPos.Y)
        TracerLine.Visible = true
    else
        TracerLine.Visible = false
    end
end

