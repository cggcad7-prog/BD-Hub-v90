local function RemovePlayerESP(plr)
    local data = ESPObjects[plr]
    if data then
        for _, obj in pairs(data) do
            pcall(function()
                if obj and obj.Remove then
                    obj:Remove()
                end
            end)
        end
        ESPObjects[plr] = nil
    end
end

