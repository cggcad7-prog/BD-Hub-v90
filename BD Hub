local function EnsurePlayerESP(plr)
    if not hasDrawing then return nil end
    if not ESPObjects[plr] then
        local box = Drawing.new("Square")
        box.Thickness = 1.5
        box.Filled = false
        box.Visible = false

        local hpBg = Drawing.new("Line")
        hpBg.Thickness = 3
        hpBg.Color = Color3.fromRGB(0, 0, 0)
        hpBg.Visible = false

        local hpFill = Drawing.new("Line")
        hpFill.Thickness = 1.5
        hpFill.Visible = false

        local nameTag = Drawing.new("Text")
        nameTag.Size = 14
        nameTag.Center = true
        nameTag.Outline = true
        nameTag.Color = Color3.fromRGB(255, 255, 255)
        nameTag.Visible = false

        ESPObjects[plr] = {
            Box = box,
            HPBg = hpBg,
            HPFill = hpFill,
            NameTag = nameTag
        }
    end
    return ESPObjects[plr]
end

local function UpdateESP(cam)
    local anyESP = hasDrawing and (Config.BoxESP or Config.HealthBarESP or Config.NameESP)
    if not anyESP then
        for plr in pairs(ESPObjects) do
            RemovePlayerESP(plr)
        end
        return
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head") or hrp
            local hum = char:FindFirstChildOfClass("Humanoid")

            if hrp and head and hum and hum.Health > 0 then
                local data = EnsurePlayerESP(plr)
                local rootPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                local headPos = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.8, 0))

                if onScreen and rootPos.Z > 0 then
                    local tanHalf = math.tan(math.rad(cam.FieldOfView * 0.5))
                    local scale = 1000 / math.max(rootPos.Z * tanHalf * 2, 0.01)
                    local w = math.clamp(math.floor(4 * scale), 8, 220)
                    local h = math.clamp(math.floor(5.5 * scale), 12, 280)
                    local boxPos = Vector2.new(rootPos.X - w * 0.5, rootPos.Y - h * 0.5)

                    local isLockedTarget = (State.LockedTarget ~= nil and plr == State.LockedTarget)
                    local boxColor = isLockedTarget
                        and Color3.fromRGB(255, 0, 0)
                        or Color3.fromRGB(255, 255, 255)

                    data.Box.Visible = Config.BoxESP
                    if Config.BoxESP then
                        data.Box.Color = boxColor
                        data.Box.Size = Vector2.new(w, h)
                        data.Box.Position = boxPos
                    end

                    data.HPBg.Visible = Config.HealthBarESP
                    data.HPFill.Visible = Config.HealthBarESP
                    if Config.HealthBarESP then
                        local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                        data.HPBg.From = Vector2.new(boxPos.X - 6, boxPos.Y + h)
                        data.HPBg.To = Vector2.new(boxPos.X - 6, boxPos.Y)
                        data.HPFill.From = Vector2.new(boxPos.X - 6, boxPos.Y + h)
                        data.HPFill.To = Vector2.new(boxPos.X - 6, boxPos.Y + (h - (h * pct)))
                        data.HPFill.Color = Color3.fromRGB(0, 255, 90)
                    end

                    data.NameTag.Visible = Config.NameESP
                    if Config.NameESP then
                        data.NameTag.Text = plr.DisplayName
                        data.NameTag.Position = Vector2.new(headPos.X, headPos.Y - 16)
                    end
                else
                    for _, obj in pairs(data) do
                        obj.Visible = false
                    end
                end
            else
                RemovePlayerESP(plr)
            end
        else
            RemovePlayerESP(plr)
        end
    end
end

RunService.RenderStepped:Connect(function()
    local cam = GetCam()
    if not cam then return end

    local refPos = GetRefScreenPos(cam)
    State.CurrentRefPos = refPos

    if Config.FOVVisible then
        FOVCircle.Position = refPos
        FOVCircle.Radius = Config.FOVRadius
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end

    local lockedHead = UpdateSingleFOVLock(cam, refPos)
    UpdateLockedTracer(cam, refPos, lockedHead)

    if Config.AimAssistEnabled and lockedHead then
        pcall(function()
            local currentCF = cam.CFrame
            local desiredCF = CFrame.lookAt(currentCF.Position, lockedHead.Position)
            cam.CFrame = currentCF:Lerp(desiredCF, 0.12)
        end)
    end

    if Config.InfiniteStamina then
        local char = LocalPlayer.Character
        if char then
            pcall(function()
                if char:GetAttribute("Stamina") ~= nil then
                    char:SetAttribute("Stamina", 100)
                end
            end)
        end
    end

    UpdateESP(cam)
end)

pcall(function()
    if hookmetamethod and getnamecallmethod then
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if Config.SilentAimEnabled and State.LockedPart and State.LockedPart.Parent then
                if method == "Raycast" and self == workspace then
                    local args = { ... }
                    if typeof(args[1]) == "Vector3" then
                        args[2] = (State.LockedPart.Position - args[1]).Unit * 1000
                        return oldNamecall(self, table.unpack(args))
                    end
                elseif method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" then
                    local args = { ... }
                    if typeof(args[1]) == "Ray" then
                        local origin = args[1].Origin
                        args[1] = Ray.new(origin, (State.LockedPart.Position - origin).Unit * 1000)
                        return oldNamecall(self, table.unpack(args))
                    end
                end
            end
            return oldNamecall(self, ...)
        end)
    end
end)
