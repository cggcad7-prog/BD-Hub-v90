task.spawn(function()
    pcall(function()
        task.wait(0.25)
        local coreGui = game:GetService("CoreGui")
        local function styleFishIcon(root)
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                    local ancestorText = ""
                    local p = obj.Parent
                    for _ = 1, 5 do
                        if not p then break end
                        for _, ch in ipairs(p:GetChildren()) do
                            if ch:IsA("TextLabel") and ch.Text == "BD Hub" then
                                ancestorText = "BD Hub"
                                break
                            end
                        end
                        if ancestorText == "BD Hub" then break end
                        p = p.Parent
                    end
                    if ancestorText == "BD Hub" and obj.AbsolutePosition.Y < 260 then
                        obj.ImageColor3 = Color3.fromRGB(0, 255, 100)
                        local curW = obj.Size.X.Offset > 0 and obj.Size.X.Offset or 22
                        local curH = obj.Size.Y.Offset > 0 and obj.Size.Y.Offset or 22
                        obj.Size = UDim2.fromOffset(math.floor(curW * 1.25), math.floor(curH * 1.25))
                        return true
                    end
                end
            end
            return false
        end

        if not styleFishIcon(coreGui) and LocalPlayer:FindFirstChild("PlayerGui") then
            styleFishIcon(LocalPlayer.PlayerGui)
        end
    end)
end)

